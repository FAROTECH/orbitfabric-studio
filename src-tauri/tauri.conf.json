{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrbitFabric Studio",
  "version": "0.14.0",
  "identifier": "io.orbitfabric.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OrbitFabric Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:1420",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
        "img-src": "'self' data: http://localhost:1420",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420",
        "script-src": "'self' http://localhost:1420",
        "font-src": "'self' http://localhost:1420",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'"
      }
    }
  },
  "bundle": {
    "active": false
  }
}
